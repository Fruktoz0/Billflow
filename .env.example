# ==============================================================================
# Billflow Environment Variables Template (.env.example)
# Copy this file to .env and configure with your own values:
#   cp .env.example .env
# ==============================================================================

# Server & Runtime Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:18520

# Docker Host Ports (Customize to avoid collisions with your existing containers)
FRONTEND_PORT=18520
BACKEND_PORT=18521

# Database Configuration (MySQL / MariaDB Server)
DB_USER=billflow_user
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DIALECT=mysql
DB_NAME=billflow

# JWT Authentication
JWT_SECRET=change_me_to_a_long_random_secret_string_for_production
JWT_EXPIRES_IN=30d

# Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@billflow.local

# Scheduled Jobs (Cron format, default: every day at 08:00 AM)
REMINDER_CRON=0 8 * * *
