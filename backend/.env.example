# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=billflow
DB_USER=billflow_user
DB_PASSWORD=billflow_password
DB_DIALECT=mysql

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_me_in_production_12345
JWT_EXPIRES_IN=7d

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@billflow.local

# Scheduled Jobs (cron format, default: every day at 08:00 AM)
REMINDER_CRON=0 8 * * *
